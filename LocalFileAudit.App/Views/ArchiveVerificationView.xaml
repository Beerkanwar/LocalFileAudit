<UserControl x:Class="LocalFileAudit.App.Views.ArchiveVerificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LocalFileAudit.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ArchiveVerificationViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header bar -->
            <RowDefinition Height="Auto" />
            <!-- Safety Invariant Banner -->
            <RowDefinition Height="Auto" />
            <!-- Path Selection Card -->
            <RowDefinition Height="Auto" />
            <!-- Progress Bar -->
            <RowDefinition Height="Auto" />
            <!-- KPI Summary Cards -->
            <RowDefinition Height="Auto" />
            <!-- Verification Items DataGrid -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Archive Verification (Compare-Archive)" FontSize="24" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Text="Validate integrity of archived external backups against local source folders via relative path matching, sizes, and on-demand SHA-256."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource AccentHoverBrush}" />
            </Border>
        </Grid>

        <!-- Safety Banner -->
        <Border Grid.Row="1" Background="#16382B" BorderBrush="{StaticResource SafeBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource SafeBrush}" CornerRadius="16" Width="30" Height="30" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="✓" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Strictly Read-Only Verification Active" FontWeight="Bold" FontSize="13" Foreground="#A7F3D0" />
                    <TextBlock Text="Source and destination files are opened exclusively with FileAccess.Read. No file mutation or execution is ever performed."
                               Foreground="#D1FAE5" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Path Selection Card -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 1: Source & Destination paths -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="SOURCE DIRECTORY (LOCAL LAPTOP)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                 Background="{StaticResource CardElevatedBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="DESTINATION DIRECTORY (EXTERNAL USB / BACKUP)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                 Background="{StaticResource CardElevatedBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                    </StackPanel>
                </Grid>

                <!-- Row 2: Checkbox & Action Buttons -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox IsChecked="{Binding CalculateSha256}" VerticalAlignment="Center"
                              ToolTip="Performs byte-by-byte SHA-256 comparison. Slower on large files but guarantees identical content.">
                        <TextBlock Text="Calculate SHA-256 hashes on-demand (Deep cryptographic verification)" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                    </CheckBox>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="✓ Verify Archive"
                                Command="{Binding StartVerificationCommand}" Height="32" Padding="18,0" Margin="0,0,8,0"
                                IsEnabled="{Binding IsVerifying, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=invert}" />

                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="✕ Cancel"
                                Command="{Binding CancelVerificationCommand}" Height="32" Padding="14,0" Margin="0,0,8,0"
                                Visibility="{Binding IsVerifying, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="📥 Export CSV..."
                                Command="{Binding ExportReportCsvCommand}" Height="32" Padding="14,0"
                                IsEnabled="{Binding HasVerificationResult}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Progress Bar Strip -->
        <Border Grid.Row="3" Visibility="{Binding IsVerifying, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="#162B3D" BorderBrush="{StaticResource AccentHoverBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="6" Margin="0,6,0,0"
                             Foreground="{StaticResource AccentHoverBrush}" Background="#0F172A" BorderThickness="0" />
            </StackPanel>
        </Border>

        <!-- KPI Metric Cards Grid -->
        <UniformGrid Grid.Row="4" Columns="5" Margin="0,0,0,16" Visibility="{Binding HasVerificationResult, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,6,0">
                <StackPanel>
                    <TextBlock Text="MATCHES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding MatchesText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource SafeBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Exact size / hash match" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="MISSING ON DEST" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding MissingText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Not copied over" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="SIZE MISMATCH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding SizeMismatchText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Different byte lengths" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="HASH MISMATCH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding HashMismatchText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Content divergence" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}" Margin="6,0,0,0">
                <StackPanel>
                    <TextBlock Text="EXTRA ON DEST" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ExtraText}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,4,0,0" />
                    <TextBlock Text="Not in source folder" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main Items Table -->
        <Border Grid.Row="5" Style="{StaticResource CardBorderStyle}" Padding="0" Visibility="{Binding HasVerificationResult, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Filter Sub-header -->
                <Grid Grid.Row="0" Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="STATUS FILTER:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding StatusFilterOptions}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Width="150" Height="28" FontSize="12" />
                    </StackPanel>

                    <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}"
                             Height="28" VerticalContentAlignment="Center" Padding="8,0" FontSize="12" Margin="12,0"
                             Background="{StaticResource CardElevatedBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />

                    <TextBlock Grid.Column="2" Text="{Binding FilteredItems.Count, StringFormat='{}Showing {0:N0} records'}"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredItems}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          Background="{StaticResource CardBackgroundBrush}"
                          BorderThickness="0,1,0,0"
                          BorderBrush="{StaticResource BorderBrush}">
                    <DataGrid.Columns>
                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Status" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Match">
                                                        <Setter Property="Background" Value="#134E3F" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="MissingAtDestination">
                                                        <Setter Property="Background" Value="#5C1D24" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="SizeMismatch">
                                                        <Setter Property="Background" Value="#5C4813" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="HashMismatch">
                                                        <Setter Property="Background" Value="#581C87" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="ExtraAtDestination">
                                                        <Setter Property="Background" Value="#1E3A8A" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Match">
                                                            <Setter Property="Foreground" Value="#6EE7B7" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="MissingAtDestination">
                                                            <Setter Property="Foreground" Value="#FCA5A5" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="SizeMismatch">
                                                            <Setter Property="Foreground" Value="#FDE68A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="HashMismatch">
                                                            <Setter Property="Foreground" Value="#D8B4FE" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="ExtraAtDestination">
                                                            <Setter Property="Foreground" Value="#93C5FD" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Relative Path" Binding="{Binding RelativePath}" Width="2*" />
                        <DataGridTextColumn Header="Source Size" Binding="{Binding SourceSizeBytes, StringFormat='{}{0:N0} B'}" Width="100" />
                        <DataGridTextColumn Header="Dest Size" Binding="{Binding DestinationSizeBytes, StringFormat='{}{0:N0} B'}" Width="100" />
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*" />
                        <DataGridTextColumn Header="Source Hash" Binding="{Binding SourceHash}" Width="130" />
                        <DataGridTextColumn Header="Dest Hash" Binding="{Binding DestinationHash}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
