<UserControl x:Class="LocalFileAudit.App.Views.ArchivePlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LocalFileAudit.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ArchivePlanViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1100">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header bar -->
            <RowDefinition Height="Auto" />
            <!-- Safety Invariant Banner -->
            <RowDefinition Height="Auto" />
            <!-- Add Batch Form -->
            <RowDefinition Height="Auto" />
            <!-- Batches Table & Actions -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Archive Batch Planner" FontSize="24" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock Text="Plan offloading cold files and large media to external USB/storage with destination capacity guards and reviewable PowerShell scripts."
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource AccentHoverBrush}" />
            </Border>
        </Grid>

        <!-- Safety Banner -->
        <Border Grid.Row="1" Background="#16382B" BorderBrush="{StaticResource SafeBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource SafeBrush}" CornerRadius="16" Width="30" Height="30" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="🛡" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Planning ≠ Executing Guarantee" FontWeight="Bold" FontSize="13" Foreground="#A7F3D0" />
                    <TextBlock Text="This planner writes text files (ArchiveManifest.csv + preview-archive.ps1 + copy-archive.ps1). It never executes them. You inspect and run them yourself in PowerShell."
                               Foreground="#D1FAE5" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Add Batch Form Card -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="16,14" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="ADD NEW ARCHIVE BATCH" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,10" />

                <!-- Row 1: Batch Name, Source Path, Destination Path -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="2.5*" />
                        <ColumnDefinition Width="2.5*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="BATCH NAME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding NewBatchName, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                 Background="{StaticResource CardElevatedBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="SOURCE DIRECTORY (ON LAPTOP)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding NewSourcePath, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                 Background="{StaticResource CardElevatedBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PLANNED DESTINATION (USB / EXTERNAL)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding NewDestinationPath, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                 Background="{StaticResource CardElevatedBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                    </StackPanel>
                </Grid>

                <!-- Row 2: Reason, Free Space Info, Add Button -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="REASON / RETENTION NOTES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                        <TextBox Text="{Binding NewReason, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0"
                                 Background="{StaticResource CardElevatedBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="DESTINATION CAPACITY CHECK" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                        <TextBlock Text="{Binding DestinationFreeSpaceText}" FontSize="12" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold" />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="➕ Add to Plan"
                            Command="{Binding AddBatchCommand}" Height="32" Padding="18,0" VerticalAlignment="Bottom" />
                </Grid>
            </Grid>
        </Border>

        <!-- Main Batches Table Card -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Sub-header -->
                    <RowDefinition Height="Auto" />
                    <!-- DataGrid -->
                    <RowDefinition Height="*" />
                    <!-- Footer Actions -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,12">
                    <TextBlock Text="PLANNED ARCHIVE BATCHES" FontSize="13" FontWeight="Bold" />
                    <TextBlock HorizontalAlignment="Right" Text="{Binding Batches.Count, StringFormat='{}Total Batches: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1" ItemsSource="{Binding Batches}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                          Background="{StaticResource CardBackgroundBrush}"
                          BorderThickness="0,1,0,1"
                          BorderBrush="{StaticResource BorderBrush}">
                    <DataGrid.Columns>
                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="Status" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="3" Padding="6,2" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                                        <Setter Property="Background" Value="#134E3F" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsVerified}" Value="False">
                                                        <Setter Property="Background" Value="#5C4813" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                                            <Setter Property="Text" Value="✓ Verified" />
                                                            <Setter Property="Foreground" Value="#6EE7B7" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsVerified}" Value="False">
                                                            <Setter Property="Text" Value="Planned" />
                                                            <Setter Property="Foreground" Value="#FDE68A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Batch Name" Binding="{Binding BatchName}" Width="150" />
                        <DataGridTextColumn Header="Source Directory" Binding="{Binding SourcePath}" Width="2*" />
                        <DataGridTextColumn Header="Planned Destination" Binding="{Binding PlannedDestinationPath}" Width="2*" />
                        <DataGridTextColumn Header="Est. Size" Binding="{Binding EstimatedSizeBytes, StringFormat='{}{0:N0} B'}" Width="100" />
                        <DataGridTextColumn Header="Files" Binding="{Binding EstimatedFileCount, StringFormat='{}{0:N0}'}" Width="75" />
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="1.5*" />

                        <!-- Row Actions -->
                        <DataGridTemplateColumn Header="Actions" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="✓ Verify" Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.MarkVerifiedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2" Height="24" FontSize="11" Margin="0,0,6,0"
                                                ToolTip="Mark batch as verified against external destination" />
                                        <Button Content="✕ Remove" Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.RemoveBatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="6,2" Height="24" FontSize="11" Foreground="{StaticResource ErrorBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer Action Bar -->
                <Border Grid.Row="2" Background="{StaticResource CardElevatedBackgroundBrush}" Padding="16,12">
                    <Grid>
                        <TextBlock Text="Ready to export reviewable manifest and scripts for manual robocopy execution."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}"
                                Content="📄 Generate Manifest &amp; Robocopy Scripts (.ps1)..."
                                Command="{Binding GenerateScriptsCommand}" Height="34" Padding="16,0" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
