<UserControl x:Class="LocalFileAudit.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LocalFileAudit.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <!-- Page Title -->
            <TextBlock Text="Settings &amp; Configuration" FontSize="26" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock Text="Manage scanning parameters, local logging privacy, safety invariants, and storage paths."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,24" />

            <!-- Status Banner (if any) -->
            <Border Visibility="{Binding StatusMessage, Converter={x:Null}}" 
                    Background="#1E293B" BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,18">
                <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" FontSize="13" />
            </Border>

            <!-- Section 1: Safety Controls (Enforced Read-Only) -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Safety Invariants (Permanent Policy)" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Background="#10B981" CornerRadius="12" Padding="10,3" HorizontalAlignment="Right">
                            <TextBlock Text="PROTECTION ACTIVE" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" />
                        </Border>
                    </Grid>
                    
                    <TextBlock Text="The application cannot delete, move, copy, or modify user files. These settings are permanently locked to preserve file integrity under all circumstances."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,14" />

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Automatic Deletion:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <TextBlock Grid.Column="1" Text="{Binding DeletionProtectionText}" FontWeight="SemiBold" Foreground="{StaticResource SafeBrush}" FontSize="13" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Automatic File Moving:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <TextBlock Grid.Column="1" Text="{Binding MoveProtectionText}" FontWeight="SemiBold" Foreground="{StaticResource SafeBrush}" FontSize="13" />
                    </Grid>

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Automatic Sync/Copy:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        <TextBlock Grid.Column="1" Text="{Binding CopyProtectionText}" FontWeight="SemiBold" Foreground="{StaticResource SafeBrush}" FontSize="13" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 2: Scanning Configuration -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Scanning Options" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <CheckBox IsChecked="{Binding IncludeFixedDrives, Mode=TwoWay}"
                              Content="Include all fixed internal drives by default" Margin="0,6" />

                    <CheckBox IsChecked="{Binding FollowReparsePoints, Mode=TwoWay}"
                              Content="Follow directory reparse points (symlinks/junctions - disabled by default for loop prevention)" Margin="0,6" />

                    <CheckBox IsChecked="{Binding LowImpactMode, Mode=TwoWay}"
                              Content="Low-impact scan mode (reduces background CPU and I/O footprint)" Margin="0,6" />

                    <CheckBox IsChecked="{Binding HashingEnabled, Mode=TwoWay}"
                              Content="Compute SHA-256 hashes during scan (disabled by default; duplicate analysis hashes on demand)" Margin="0,6" />

                    <Grid Margin="0,12,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Max Concurrent Directory Workers:" VerticalAlignment="Center" FontSize="13" />
                        <TextBox Grid.Column="1" Text="{Binding MaxWorkers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="2" Text="(1 to 16, default: 2)" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" />
                    </Grid>

                    <Grid Margin="0,8,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Database Commit Batch Size:" VerticalAlignment="Center" FontSize="13" />
                        <TextBox Grid.Column="1" Text="{Binding BatchSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="2" Text="(10 to 50000, default: 500)" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 3: Storage Analysis Thresholds -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Deterministic Analysis Thresholds" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Large File Threshold (MB):" VerticalAlignment="Center" FontSize="13" />
                        <TextBox Grid.Column="1" Text="{Binding LargeFileThresholdMb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="2" Text="(default: 500 MB)" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" />
                    </Grid>

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Old File Inactivity Threshold (Days):" VerticalAlignment="Center" FontSize="13" />
                        <TextBox Grid.Column="1" Text="{Binding OldFileAgeDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" />
                        <TextBlock Grid.Column="2" Text="(default: 730 days = 2 years)" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 4: Local AI Settings -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Local AI (Ollama Integration)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <CheckBox IsChecked="{Binding AiEnabled, Mode=TwoWay}"
                              Content="Enable Local Ollama AI analysis (requires Ollama running on localhost)" Margin="0,4" />

                    <CheckBox IsChecked="{Binding RequireLocalEndpoint, Mode=TwoWay}"
                              Content="Enforce local loopback address only (rejects remote/external URLs)" Margin="0,4" />

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ollama Endpoint URL:" VerticalAlignment="Center" FontSize="13" />
                        <TextBox Grid.Column="1" Text="{Binding AiEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 5: Logging & Privacy -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Logging, Diagnostics &amp; Privacy" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <CheckBox IsChecked="{Binding RedactFilePaths, Mode=TwoWay}"
                              Content="Redact personal user profile paths in diagnostic logs (e.g. C:\Users\[USER])" Margin="0,4" />

                    <Grid Margin="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Log File Retention Period (Days):" VerticalAlignment="Center" FontSize="13" />
                        <TextBox Grid.Column="1" Text="{Binding LogRetainDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80" HorizontalAlignment="Left" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 6: Local Application Data Paths -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Designated Application Storage Locations" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Config File:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding ConfigPath}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Logs Directory:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding LogsPath}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Database Path:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Grid.Column="1" Text="{Binding DatabasePath}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Reset to Defaults" Command="{Binding ResetDefaultsCommand}" Margin="0,0,12,0" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Content="Save Settings" Command="{Binding SaveCommand}" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
