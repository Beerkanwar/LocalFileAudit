<UserControl x:Class="LocalFileAudit.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LocalFileAudit.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            
            <!-- Page Title -->
            <TextBlock Text="Dashboard" FontSize="26" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock Text="Storage overview, file inventory metrics, and decision-support summary."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,24" />

            <!-- Safety Guarantee Banner -->
            <Border Background="#16382B" BorderBrush="{StaticResource SafeBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SafeBrush}" CornerRadius="16" Width="32" Height="32" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="✓" Foreground="#FFFFFF" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Safe Read-Only Analysis Guarantee" FontWeight="Bold" FontSize="14" Foreground="#A7F3D0" />
                        <TextBlock Text="LocalFileAudit is an analysis and decision-support tool. It never mutates, deletes, or moves user files. All operations run strictly read-only and 100% locally."
                                   Foreground="#D1FAE5" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Quick Metrics Grid -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                
                <!-- Metric 1: Total Files -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="INVENTORIED FILES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding TotalFilesDiscoveredText}" FontSize="24" FontWeight="Bold" Margin="0,8,0,0" />
                        <TextBlock Text="Awaiting scan run" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Metric 2: Total Logical Size -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="INVENTORIED SIZE" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding TotalLogicalSizeText}" FontSize="24" FontWeight="Bold" Margin="0,8,0,0" />
                        <TextBlock Text="Logical bytes" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Metric 3: Drives Scanned -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="6,0,6,0">
                    <StackPanel>
                        <TextBlock Text="DRIVES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding DrivesCountText}" FontSize="24" FontWeight="Bold" Margin="0,8,0,0" />
                        <TextBlock Text="Fixed internal drives" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Metric 4: Scanner State -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ENGINE STATUS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding ScanStateText}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" Foreground="{StaticResource AccentHoverBrush}" />
                        <TextBlock Text="Ready for Phase 2" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Foundation Status / Info Card -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Phase 1 Foundation Operational" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="The application architecture, dependency injection container, structured configuration system, rolling local file logging with path redaction, and core validation pipeline are active."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Active Architectural Invariants:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                            <TextBlock Text="• Layered separation: Core, Infrastructure, App, Tests" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2" />
                            <TextBlock Text="• Configuration loaded with atomic file operations" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2" />
                            <TextBlock Text="• Destructive file mutations permanently rejected by validator" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="Upcoming Milestones:" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                            <TextBlock Text="• Phase 2: SQLite crash-safe persistence and scan engine" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2" />
                            <TextBlock Text="• Phase 3: Deterministic storage aggregations and CSV/Markdown reports" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2" />
                            <TextBlock Text="• Phase 4: Interactive virtualized inventory dashboard" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
