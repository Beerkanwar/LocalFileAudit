<UserControl x:Class="LocalFileAudit.App.Views.AiReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LocalFileAudit.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AiReportsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="AI Reports" FontSize="26" FontWeight="Bold" Margin="0,0,0,6" />
        <TextBlock Grid.Row="1" Text="Optional decision-support reports powered by local Ollama instances running on localhost."
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,16" />

        <!-- Privacy & Offline Guarantee -->
        <Border Grid.Row="2" Background="#14283A" BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ℹ" Foreground="{StaticResource AccentHoverBrush}" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Local AI Privacy Guarantee" FontWeight="Bold" FontSize="14" Foreground="#BAE6FD" />
                    <TextBlock Text="{Binding AiPrivacyNotice}" Foreground="#E0F2FE" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Local Ollama Inference Engine" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,16" />
                <TextBlock Text="Phase 5 will implement local Ollama model verification, compact aggregate prompts, JSON schema enforcement, and structured executive reports."
                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
