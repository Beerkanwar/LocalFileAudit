<UserControl x:Class="LocalFileAudit.App.Views.AiReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LocalFileAudit.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AiReportsViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1050">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <!-- Header -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="AI Decision Support Reports" FontSize="26" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="Optional local AI inference via Ollama for intelligent storage summarization and review planning."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource AccentHoverBrush}" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                </Border>
            </Grid>

            <!-- Privacy Guarantee Banner -->
            <Border Background="#16382B" BorderBrush="{StaticResource SafeBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource SafeBrush}" CornerRadius="16" Width="30" Height="30" Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="🤖" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="100% Local Inference &amp; Privacy Guarantee" FontWeight="Bold" FontSize="13" Foreground="#A7F3D0" />
                        <TextBlock Text="All AI analysis runs entirely on your local machine via Ollama on localhost. Remote endpoints are rejected by policy. Document contents are NEVER submitted to the model. AI failure cannot alter or prevent deterministic reports."
                                   Foreground="#D1FAE5" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Ollama Connection & Model Selection Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Local Ollama Configuration" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="ENDPOINT URL (LOCALHOST ONLY)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Endpoint, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" Padding="8,0" FontSize="12" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="AVAILABLE LOCAL MODEL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding SelectedModel}" Height="32" FontSize="12" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="🔌 Test Connection" Command="{Binding TestConnectionCommand}" Height="32" Padding="14,0" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource CardElevatedBackgroundBrush}" CornerRadius="4" Padding="10,6">
                        <TextBlock Text="{Binding ConnectionStatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Scan Selection & Prompt Preview Expander -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Inference Input &amp; Data Minimization" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Inspect and verify the exact minimized summary payload before submitting to the local model."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding RedactPersonalPaths, Mode=TwoWay}" Content="Redact personal user paths" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="👁 Preview Minimized Input" Command="{Binding GeneratePromptPreviewCommand}" Height="30" Padding="10,0" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Target Scan Run:" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableScans}" SelectedItem="{Binding SelectedScan}" DisplayMemberPath="DisplayText" Height="30" FontSize="12" />
                    </Grid>

                    <!-- Preview Text Box -->
                    <TextBox Text="{Binding PromptPreviewText, Mode=OneWay}"
                             Height="140" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="#16181D" Foreground="#A5B4FC" FontFamily="Consolas, Courier New" FontSize="11"
                             Padding="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />

                    <!-- Run Actions Strip -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ProgressBar IsIndeterminate="{Binding IsGenerating}" Height="4" VerticalAlignment="Center" Margin="0,0,16,0"
                                     Foreground="{StaticResource AccentPrimaryBrush}" Background="Transparent" BorderThickness="0"
                                     Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="⏹ Cancel" Command="{Binding CancelAiAnalysisCommand}"
                                    IsEnabled="{Binding IsGenerating}" Height="34" Padding="14,0" Margin="0,0,10,0" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="⚡ Run Local AI Analysis" Command="{Binding RunAiAnalysisCommand}"
                                    Height="34" Padding="18,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- AI Results Section (Visible when results generated) -->
            <StackPanel Visibility="{Binding HasAiResults, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,20">

                <!-- Executive Summary & Hotspots Cards -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Executive Summary (AI Decision Support)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding ExecutiveSummary}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="18" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Storage Hotspots Assessment" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding StorageHotspots}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="18" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- AI Candidate Recommendations -->
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="AI Candidate Recommendations" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="📥 Export Review Table (CSV / MD)" Command="{Binding ExportAiReviewTableCommand}" Height="28" Padding="12,0" FontSize="11" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Recommendations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardElevatedBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Row 1: Header -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#2C2415" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SuggestedCategory}" FontSize="11" FontWeight="Bold" Foreground="#FCD34D" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding FileName}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="10,0" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ConfidenceLevel, StringFormat='{}Confidence: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="💬 Ask AI"
                                                            Command="{Binding DataContext.AddCandidateToChatContextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding CandidateId}"
                                                            Height="24" Padding="8,0" FontSize="11" Margin="0,0,6,0" />
                                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="🔍 Inspect in Inventory"
                                                            Command="{Binding DataContext.InspectCandidateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding CandidateId}"
                                                            Height="24" Padding="8,0" FontSize="11" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Row 2: Details & Verification -->
                                            <StackPanel Grid.Row="1" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding Explanation}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding Evidence, StringFormat='{}Evidence: {0}'}" FontSize="11" Foreground="{StaticResource AccentHoverBrush}" TextWrapping="Wrap" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding RecommendedVerificationStep, StringFormat='{}Verification: {0}'}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Prioritized Review Plan & Safety Warnings Grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Prioritized Review Plan" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding ReviewPlan}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='{}• {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Safety Warnings &amp; Guidance" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding SafetyWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='{}⚠ {0}'}" FontSize="12" Foreground="#FCD34D" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>

            <!-- F5: AI Follow-up Chat ("Ask about this scan") -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="AI Follow-up Chat (Ask About This Scan)" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Ask questions about candidates, storage patterns, or review criteria grounded strictly in this scan's metadata. Advisory-only."
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="🗑 Clear Chat"
                                Command="{Binding ClearChatHistoryCommand}" Height="28" Padding="10,0" FontSize="11" />
                    </Grid>

                    <!-- Chat Messages List -->
                    <Border Background="#16181D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" MinHeight="140" MaxHeight="300" Margin="0,0,0,12" Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="No chat messages yet for this scan. Type a question below or click '💬 Ask AI' on any candidate above."
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="8">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ChatMessages.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ItemsControl ItemsSource="{Binding ChatMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="10,8" Margin="0,4" MaxWidth="850">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1E293B" />
                                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Sender}" Value="user">
                                                                <Setter Property="Background" Value="#1E3A5F" />
                                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding Sender, StringFormat='{}• {0}'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentHoverBrush}" />
                                                        <TextBlock Text="{Binding CreatedAtUtc, StringFormat='{}{0:HH:mm}'}" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" LineHeight="17" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Chat Input Strip -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ChatInputText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="36" VerticalContentAlignment="Center" Padding="10,0" FontSize="12"
                                 Background="{StaticResource CardElevatedBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendChatMessageCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="Send 💬"
                                Command="{Binding SendChatMessageCommand}"
                                Height="36" Padding="18,0" Margin="8,0,0,0" />
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <TextBlock Text="{Binding ChatStatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- AI Reports History Section -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="AI Report History" FontSize="15" FontWeight="SemiBold" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="↻ Refresh History" Command="{Binding RefreshHistoryCommand}"
                                HorizontalAlignment="Right" Height="26" Padding="10,0" FontSize="11" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding AiReportHistory}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardElevatedBackgroundBrush}" CornerRadius="4" Padding="10,8" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding GeneratedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ModelName}" FontSize="12" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding ReportPath}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0" />
                                        <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" Content="📄 Open Review" Height="26" Padding="8,0" FontSize="11"
                                                Command="{Binding DataContext.OpenReportFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding ReportPath}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
