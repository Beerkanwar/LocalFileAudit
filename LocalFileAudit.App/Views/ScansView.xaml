<UserControl x:Class="LocalFileAudit.App.Views.ScansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LocalFileAudit.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ScansViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="950">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">

            <!-- Title Header -->
            <TextBlock Text="Scan Center" FontSize="26" FontWeight="Bold" Margin="0,0,0,6" />
            <TextBlock Text="Configure drive scope, monitor live scan progress, and manage historical inventory runs."
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" Margin="0,0,0,20" />

            <!-- Incomplete Scan Recovery Prompt (Visible only if an interrupted scan exists) -->
            <Border Visibility="{Binding HasIncompleteScan, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="#2A1B0E" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Incomplete Scan Detected" FontWeight="Bold" FontSize="15" Foreground="#FCD34D" />
                        <TextBlock Text="A previous scan was interrupted or terminated before completing. Previously committed database batches remain safely preserved in SQLite."
                                   Foreground="#FDE68A" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Discard Records" Command="{Binding DiscardIncompleteScanCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Resume Scan" Command="{Binding ResumeIncompleteScanCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Target Scope Selection Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Scan Scope (Internal Drives &amp; Directories)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <!-- Drive Checkboxes -->
                    <ItemsControl ItemsSource="{Binding AvailableDrives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Content="{Binding Description}"
                                          Margin="0,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Custom Directory Input -->
                    <Grid Margin="0,12,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Or Specific Folder:" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding CustomDirectoryPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>

                    <!-- Start Button Row -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="▶  Start File Inventory Scan" Command="{Binding StartScanCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Live Progress Card -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Live Scan Engine Status" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ScanStatusText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource AccentHoverBrush}" FontWeight="SemiBold" />
                    </Grid>

                    <!-- Metrics Grid -->
                    <UniformGrid Columns="4" Margin="0,8,0,16">
                        <Border Background="{StaticResource CardElevatedBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="FILES DISCOVERED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding FilesDiscovered, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardElevatedBackgroundBrush}" CornerRadius="6" Padding="12" Margin="6,0,6,0">
                            <StackPanel>
                                <TextBlock Text="DIRECTORIES COMPLETED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding DirectoriesCompleted, StringFormat='{}{0:N0}'}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardElevatedBackgroundBrush}" CornerRadius="6" Padding="12" Margin="6,0,6,0">
                            <StackPanel>
                                <TextBlock Text="SCAN RATE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding FilesPerSecond, StringFormat='{}{0:N0} files/sec'}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource CardElevatedBackgroundBrush}" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="ELAPSED TIME" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding ElapsedTime, StringFormat='{}{0:hh\\:mm\\:ss}'}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Current Directory Path -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Current Folder:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding CurrentDirectory}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- Control Buttons (Pause, Resume, Cancel) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="⏸  Pause" Command="{Binding PauseScanCommand}" Margin="0,0,10,0" IsEnabled="{Binding IsScanning}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="▶  Resume" Command="{Binding ResumeScanCommand}" Margin="0,0,10,0" IsEnabled="{Binding IsPaused}" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="⏹  Cancel Scan" Command="{Binding CancelScanCommand}" IsEnabled="{Binding IsScanning}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Historical Scans Table -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Historical Scan Runs" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="↻ Refresh" Command="{Binding RefreshScansCommand}" HorizontalAlignment="Right" Height="30" Padding="12,0" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentScans}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardElevatedBackgroundBrush}" CornerRadius="6" Padding="12" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="220" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding StartTimeUtc, Converter={StaticResource UtcToLocalDateTimeConverter}, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontWeight="SemiBold" FontSize="13" />
                                            <TextBlock Text="{Binding ApplicationVersion, StringFormat='{}v{0}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                        </StackPanel>

                                        <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#1E293B" CornerRadius="4" Padding="8,2">
                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentHoverBrush}" />
                                        </Border>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                            <TextBlock Text="{Binding SelectedDrives, StringFormat='{}Roots: {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ErrorCount, StringFormat='{}Errors: {0}'}" FontSize="11" Foreground="{StaticResource WarningBrush}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding FilesDiscovered, StringFormat='{}{0:N0} files'}" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding DirectoriesCompleted, StringFormat='{}{0:N0} dirs'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="📋 Files" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="11"
                                                    Command="{Binding DataContext.ViewInventoryForScanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}" ToolTip="Search and view files for this scan run" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="📈 Analysis" Height="26" Padding="8,0" Margin="0,0,4,0" FontSize="11"
                                                    Command="{Binding DataContext.ViewAnalysisForScanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}" ToolTip="Open detailed storage analysis" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="✕" Height="26" Padding="8,0" FontSize="11" Foreground="{StaticResource ErrorBrush}"
                                                    Command="{Binding DataContext.DeleteScanHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Id}" IsEnabled="{Binding DataContext.CanDelete, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="Delete this scan history record from database (source files untouched)" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
