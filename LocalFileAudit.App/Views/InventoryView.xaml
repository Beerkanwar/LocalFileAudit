<UserControl x:Class="LocalFileAudit.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LocalFileAudit.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:InventoryViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Title & Filters Header -->
            <RowDefinition Height="Auto" />
            <!-- Main Inventory Data Table -->
            <RowDefinition Height="*" />
            <!-- Pagination Controls -->
            <RowDefinition Height="Auto" />
            <!-- File Inspection Detail Panel -->
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <!-- Section 1: Header & Filter Bar -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="File Inventory" FontSize="24" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="Search, inspect, and filter discovered files across drives with explainable rule evaluation."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource AccentHoverBrush}" />
                </Border>
            </Grid>

            <!-- Filter Controls Strip -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Row: Search text + Action buttons -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="34" VerticalContentAlignment="Center" Padding="10,0" FontSize="13"
                                 Background="{StaticResource CardElevatedBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="🔍 Search"
                                Command="{Binding SearchCommand}" Margin="10,0,0,0" Height="34" />

                        <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="↺ Reset"
                                Command="{Binding ResetFiltersCommand}" Margin="8,0,0,0" Height="34" />

                        <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" Content="📥 Export Full CSV..."
                                Command="{Binding ExportFullInventoryCommand}" Margin="8,0,0,0" Height="34"
                                ToolTip="Streams every file from the selected scan run to a reviewable CSV with calculated age and rule categories" />
                    </Grid>

                    <!-- Bottom Row: Filter Dropdowns -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Scan Run Selector -->
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="SCAN RUN" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding AvailableScanRuns}"
                                      SelectedItem="{Binding SelectedScanRun}"
                                      DisplayMemberPath="DisplayText"
                                      Height="30" FontSize="12" />
                        </StackPanel>

                        <!-- Extension Selector -->
                        <StackPanel Grid.Column="1" Margin="4,0,8,0">
                            <TextBlock Text="EXTENSION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding AvailableExtensions}"
                                      SelectedItem="{Binding SelectedExtension}"
                                      Height="30" FontSize="12" />
                        </StackPanel>

                        <!-- Minimum Size Selector -->
                        <StackPanel Grid.Column="2" Margin="4,0,8,0">
                            <TextBlock Text="SIZE FILTER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding SizeFilterOptions}"
                                      SelectedItem="{Binding SelectedSizeOption}"
                                      DisplayMemberPath="DisplayName"
                                      Height="30" FontSize="12" />
                        </StackPanel>

                        <!-- Age / Modified Selector -->
                        <StackPanel Grid.Column="3" Margin="4,0,0,0">
                            <TextBlock Text="AGE FILTER" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding AgeFilterOptions}"
                                      SelectedItem="{Binding SelectedAgeOption}"
                                      DisplayMemberPath="DisplayName"
                                      Height="30" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Full Inventory Export Progress Notification -->
            <Border Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="#162B3D" BorderBrush="{StaticResource AccentHoverBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="14,10" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ExportStatusText}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        <ProgressBar Value="{Binding ExportProgressPercent}" Maximum="100" Height="6" Margin="0,6,0,0"
                                     Foreground="{StaticResource AccentHoverBrush}" Background="#0F172A" BorderThickness="0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="✕ Cancel Export"
                            Command="{Binding CancelExportCommand}" Height="28" Padding="10,0" Margin="14,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Section 2: Virtualized High-Performance DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,0,0,10">
            <DataGrid ItemsSource="{Binding Files}"
                      SelectedItem="{Binding SelectedFile}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                      Background="{StaticResource CardBackgroundBrush}"
                      Foreground="{StaticResource TextPrimaryBrush}"
                      BorderThickness="0"
                      RowBackground="{StaticResource CardBackgroundBrush}"
                      AlternatingRowBackground="{StaticResource CardElevatedBackgroundBrush}"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      FontSize="12">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource SidebarBackgroundBrush}" />
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="11" />
                        <Setter Property="Padding" Value="10,8" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Padding" Value="0,4" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1E3A5F" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="FILE NAME" Width="240">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="10,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="EXT" Binding="{Binding Extension}" Width="80" />

                    <DataGridTemplateColumn Header="SIZE" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SizeBytes, StringFormat='{}{0:N0} B'}"
                                           VerticalAlignment="Center" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentHoverBrush}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="LAST MODIFIED" Binding="{Binding LastWriteTimeUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="140" />

                    <DataGridTemplateColumn Header="CONTAINING DIRECTORY" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ParentPath}" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Section 3: Pagination Bar -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Total Records: " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding TotalCount, StringFormat='{}{0:N0}'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,16,0" />
                <TextBlock Text="Page " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding CurrentPage}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text=" of " FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding TotalPages}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="⏮ First" Command="{Binding FirstPageCommand}" Height="28" Padding="10,0" Margin="0,0,4,0" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="◀ Prev" Command="{Binding PreviousPageCommand}" Height="28" Padding="10,0" Margin="0,0,8,0" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Next ▶" Command="{Binding NextPageCommand}" Height="28" Padding="10,0" Margin="0,0,4,0" />
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Last ⏭" Command="{Binding LastPageCommand}" Height="28" Padding="10,0" />
            </StackPanel>
        </Grid>

        <!-- Section 4: File Inspection Detail Panel -->
        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: File Details -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedFile.FileName, FallbackValue='No file selected'}"
                                   FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="📋 Copy Path" Command="{Binding CopyPathCommand}" Height="26" Padding="8,0" Margin="0,0,6,0" FontSize="11" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="📂 Open Folder" Command="{Binding RevealInExplorerCommand}" Height="26" Padding="8,0" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding SelectedFile.FullPath, FallbackValue='Select a file from the inventory table above to inspect details.'}"
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="LOGICAL SIZE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedFile.SizeBytes, StringFormat='{}{0:N0} bytes', FallbackValue='—'}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ON-DISK (ALLOCATED)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedAllocatedSizeText, FallbackValue='—'}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="LAST MODIFIED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedFile.LastWriteTimeUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss} UTC', FallbackValue='—'}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="ATTRIBUTES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedAttributesText, FallbackValue='—'}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Right Column: Decision-Support Classification -->
                <Border Grid.Column="1" Background="{StaticResource CardElevatedBackgroundBrush}" CornerRadius="6" Padding="14">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="DECISION-SUPPORT CLASSIFICATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" />
                            <Border HorizontalAlignment="Right" Background="#2C2415" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding SelectedCategory, FallbackValue='None'}" FontSize="11" FontWeight="Bold" Foreground="#FCD34D" />
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding SelectedExplanation, FallbackValue='Select an item to view classification rule explanation.'}"
                                   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBlock Text="Verification Guidance:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding SelectedVerificationHint, FallbackValue='—'}"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
