<Window x:Class="LocalFileAudit.App.Services.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LocalFileAudit Notification"
        Height="85" Width="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Border Background="#16181D" BorderBrush="#383C4A" BorderThickness="1" CornerRadius="8" Padding="14,10"
            Cursor="Hand" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" Color="#000000" Opacity="0.5" ShadowDepth="4" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <Border Grid.Column="0" x:Name="IconBadge" Background="#16382B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Width="34" Height="34" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="IconText" Text="✓" FontSize="16" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Text Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleBlock" Text="Scan Completed" FontWeight="Bold" FontSize="13" Foreground="#F3F4F6" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MessageBlock" Text="12,500 files inventoried safely." FontSize="11" Foreground="#9CA3AF" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Column="2" Content="✕" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Foreground="#6B7280" Background="Transparent" BorderThickness="0" FontSize="10" Cursor="Hand" Click="CloseButton_Click" />
        </Grid>
    </Border>
</Window>
