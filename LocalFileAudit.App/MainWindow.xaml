<Window x:Class="LocalFileAudit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LocalFileAudit.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        mc:Ignorable="d"
        Title="LocalFileAudit — Local Storage Intelligence &amp; Decision Support"
        Height="760" Width="1180"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    
    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="64" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentPrimaryBrush}" CornerRadius="6" Width="34" Height="34" Margin="0,0,12,0">
                        <TextBlock Text="📁" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LocalFileAudit" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Local Storage Intelligence &amp; Decision Support" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Center: Safety Mode Indicator Badge -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Background="#16382B" BorderBrush="{StaticResource SafeBrush}" BorderThickness="1" CornerRadius="14" Padding="14,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡" Foreground="{StaticResource SafeBrush}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="SAFE MODE: READ-ONLY (Mutations Disabled)" Foreground="#A7F3D0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Version Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="{Binding AppVersion}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Navigation Sidebar + Active View Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12,16">
                <DockPanel LastChildFill="True">

                    <!-- Bottom Safety Summary in Sidebar -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="SAFETY ASSURANCE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SafeBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="• Read-only scans" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1" />
                            <TextBlock Text="• No file modification" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1" />
                            <TextBlock Text="• 100% offline &amp; local" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1" />
                        </StackPanel>
                    </Border>

                    <!-- Nav Buttons -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="NAVIGATION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,8" />

                        <Button Style="{StaticResource NavButtonStyle}" Content="📊  Dashboard"
                                Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />

                        <Button Style="{StaticResource NavButtonStyle}" Content="🔍  Scans"
                                Command="{Binding NavigateCommand}" CommandParameter="Scans" />

                        <Button Style="{StaticResource NavButtonStyle}" Content="📋  File Inventory"
                                Command="{Binding NavigateCommand}" CommandParameter="Inventory" />

                        <Button Style="{StaticResource NavButtonStyle}" Content="📈  Storage Analysis"
                                Command="{Binding NavigateCommand}" CommandParameter="StorageAnalysis" />

                        <Button Style="{StaticResource NavButtonStyle}" Content="📑  Duplicate Analysis"
                                Command="{Binding NavigateCommand}" CommandParameter="DuplicateAnalysis" />

                        <Button Style="{StaticResource NavButtonStyle}" Content="🤖  AI Reports"
                                Command="{Binding NavigateCommand}" CommandParameter="AiReports" />

                        <Separator Background="{StaticResource BorderBrush}" Margin="8,10" />

                        <Button Style="{StaticResource NavButtonStyle}" Content="⚙  Settings"
                                Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1" Background="{StaticResource WindowBackgroundBrush}">
                <ContentControl Content="{Binding CurrentViewModel}" Focusable="False" />
            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Priority 1: Read-Only Protected" FontSize="11" Foreground="{StaticResource SafeBrush}" Margin="0,0,24,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding AppVersion}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</Window>
